---
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';
import DocsSearch from '../components/docs/DocsSearch.astro';
import { docsOrder } from '../content/docs-sidebar';

interface Props {
  /** Page title shown in the browser tab and as the <h1>. */
  title: string;
  /** Optional one-line description (also used for meta + og). */
  description?: string;
  /** Slug of the current page (without leading slash). Empty for /docs/. */
  slug: string;
}

const { title, description, slug } = Astro.props;

// Compute prev / next for the bottom navigation
const idx = docsOrder.findIndex((p) => p.slug === slug);
const prev = idx > 0 ? docsOrder[idx - 1] : null;
const next = idx >= 0 && idx < docsOrder.length - 1 ? docsOrder[idx + 1] : null;
---

<BaseLayout title={`${title} — Docs`} description={description}>
  <div class="docs-grid mx-auto max-w-7xl px-4 py-8">
    <aside class="docs-aside">
      <div class="sticky top-8 max-h-[calc(100vh-4rem)] overflow-y-auto pb-12 pr-2">
        <a
          href="/docs/"
          class="mb-6 inline-flex items-center gap-2 text-sm font-semibold text-foreground hover:text-primary transition-colors"
        >
          ← Docs
        </a>
        <DocsSearch />
        <DocsSidebar current={slug} />
      </div>
    </aside>

    <main class="docs-main min-w-0">
      <article class="prose prose-neutral dark:prose-invert max-w-none">
        <header class="mb-8 border-b border-border pb-6">
          <h1 class="!mb-2 text-3xl font-bold tracking-tight" style="view-transition-name: page-title">
            {title}
          </h1>
          {description && <p class="!mt-0 text-muted-foreground">{description}</p>}
        </header>

        <div class="docs-content">
          <slot />
        </div>

        {(prev || next) && (
          <nav class="mt-12 grid grid-cols-1 gap-4 border-t border-border pt-6 sm:grid-cols-2">
            {prev ? (
              <a
                href={`/docs/${prev.slug}/`.replace(/\/+$/, '/')}
                class="group flex flex-col rounded-lg border border-border bg-card px-4 py-3 text-card-foreground transition-colors hover:bg-accent/40"
                rel="prev"
              >
                <span class="text-xs uppercase tracking-wide text-muted-foreground">Previous</span>
                <span class="mt-1 font-medium group-hover:underline">← {prev.label}</span>
              </a>
            ) : (
              <span></span>
            )}
            {next ? (
              <a
                href={`/docs/${next.slug}/`.replace(/\/+$/, '/')}
                class="group flex flex-col items-end rounded-lg border border-border bg-card px-4 py-3 text-right text-card-foreground transition-colors hover:bg-accent/40"
                rel="next"
              >
                <span class="text-xs uppercase tracking-wide text-muted-foreground">Next</span>
                <span class="mt-1 font-medium group-hover:underline">{next.label} →</span>
              </a>
            ) : (
              <span></span>
            )}
          </nav>
        )}
      </article>
    </main>
  </div>
</BaseLayout>

<style>
  .docs-grid {
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: 3rem;
  }

  @media (max-width: 1024px) {
    .docs-grid {
      grid-template-columns: 1fr;
    }
    .docs-aside {
      display: none;
    }
  }

  .docs-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--foreground);
  }
  .docs-content :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--foreground);
  }
  .docs-content :global(p) {
    line-height: 1.7;
    color: var(--foreground);
    margin-bottom: 1rem;
  }
  .docs-content :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .docs-content :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .docs-content :global(code:not(pre code)) {
    background: var(--muted);
    color: var(--foreground);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
    border: 1px solid var(--border);
  }
  .docs-content :global(pre) {
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .docs-content :global(blockquote) {
    border-left: 3px solid var(--primary);
    padding-left: 1rem;
    color: var(--muted-foreground);
    font-style: italic;
  }
  .docs-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }
  .docs-content :global(th),
  .docs-content :global(td) {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .docs-content :global(th) {
    background: var(--muted);
    font-weight: 600;
  }
  .docs-content :global(ul),
  .docs-content :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  .docs-content :global(ul) {
    list-style: disc;
  }
  .docs-content :global(ol) {
    list-style: decimal;
  }
  .docs-content :global(li) {
    margin-bottom: 0.25rem;
  }
  .docs-content :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
</style>
