---
/**
 * A soft panel with a title and a grid of short principles, each under a
 * strong rule (marketing block, #338).
 */
interface Props {
  title: string;
  lead?: string;
  items: { title: string; text: string }[];
  tag?: 'h2' | 'h3';
}
const { title, lead, items, tag: Tag = 'h2' } = Astro.props;
---

<div class="rounded-3xl bg-muted p-6 sm:p-10">
  <Tag
    class="font-display text-3xl font-bold leading-tight tracking-tight text-foreground sm:text-5xl"
  >
    {title}
  </Tag>
  {lead && <p class="mt-4 max-w-prose text-base leading-relaxed text-muted-foreground">{lead}</p>}
  <dl class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item) => (
        <div class="border-t-2 border-foreground pt-4">
          <dt class="font-display text-xl font-bold leading-snug tracking-tight text-foreground">
            {item.title}
          </dt>
          <dd class="mt-2 text-base leading-relaxed text-muted-foreground">{item.text}</dd>
        </div>
      ))
    }
  </dl>
</div>
