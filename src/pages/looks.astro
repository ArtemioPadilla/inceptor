---
import '@fontsource-variable/bricolage-grotesque';
import { withBase } from '@/lib/href';
import BaseLayout from '../layouts/BaseLayout.astro';
import AccentPicker from '../components/islands/AccentPicker';
import HeroGraphic from '../components/blocks/HeroGraphic.astro';
import HighlightHeadline from '../components/blocks/HighlightHeadline.astro';
import PairedCards from '../components/blocks/PairedCards.astro';
import LevelLadder from '../components/blocks/LevelLadder.astro';
import PrinciplesPanel from '../components/blocks/PrinciplesPanel.astro';
import CtaBand from '../components/blocks/CtaBand.astro';
import { LOOKS, LOOK_COPY } from '../../scripts/looks.mjs';

// The previews compose the same blocks, in the same order, as
// scripts/looks.mjs writes into a generated project, with the same
// placeholder copy (src/tests/looks-page.test.ts keeps them in step).
const t = LOOK_COPY.en;
const name = 'Your product';
const cards = t.cards as [(typeof t.cards)[number], (typeof t.cards)[number]];

const BUTTON = 'inline-flex min-h-12 items-center rounded-xl px-6 py-3 text-base font-semibold';
const PRIMARY = `${BUTTON} bg-primary text-primary-foreground`;
const SECONDARY = `${BUTTON} border border-input bg-background text-foreground`;
const H =
  'font-display text-3xl font-bold leading-tight tracking-tight text-foreground sm:text-5xl';
const FRAME =
  'look max-h-[44rem] overflow-y-auto rounded-xl border border-border bg-background focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring';
---

<BaseLayout
  title="Looks — inceptor"
  description="Three starting landings a project can be generated with: editorial, bold and product. Each has its own type and composition, built from the marketing blocks."
>
  <main id="main-content" class="mx-auto max-w-6xl space-y-12 px-4 py-12">
    <header class="max-w-3xl">
      <h1 class="text-3xl font-bold tracking-tight">Looks</h1>
      <p class="mt-2 text-muted-foreground">
        A project generated from Inceptor does not have to start from a centred title. Pass
        <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">--look</code> to the generator
        and it writes one of these three landings, built from the
        <a
          href={withBase('/blocks/marketing/')}
          class="text-primary underline underline-offset-2 hover:text-primary/80"
          >marketing blocks</a
        >, with its own display face. The copy is placeholder on purpose.
      </p>
      <p class="mt-2 text-muted-foreground">
        A look is a starting point, not a design. The generated project still sends you through a
        design round before you build pages:
        <a
          href={withBase('/blog/2026-11-design-round-buro-del-pueblo/')}
          class="text-primary underline underline-offset-2 hover:text-primary/80"
          >how that went for Buró del Pueblo</a
        >.
      </p>
    </header>

    <section aria-labelledby="accent-title" class="space-y-3">
      <h2 id="accent-title" class="text-xl font-semibold">Try an accent</h2>
      <AccentPicker client:visible />
    </section>

    <div data-accent-scope class="space-y-12">
      <section aria-labelledby="look-editorial" class="space-y-3">
        <h2 id="look-editorial" class="text-xl font-semibold">Editorial</h2>
        <p class="text-muted-foreground">Serif display ({LOOKS.editorial.summary}).</p>
        <pre
          class="overflow-x-auto rounded-md bg-muted px-3 py-2 font-mono text-xs"><code>node scripts/init.mjs --name my-app --out ../my-app --look editorial</code></pre>
        <div
          data-look="editorial"
          class={FRAME}
          role="region"
          aria-label="Editorial look preview"
          tabindex="0"
        >
          <div class="mx-auto max-w-4xl px-5 pb-12 pt-16">
            <p class="font-mono text-sm uppercase tracking-widest text-primary">{t.eyebrow}</p>
            <HighlightHeadline
              tag="h3"
              size="hero"
              text={name}
              highlight={t.highlight}
              class="mt-4"
            />
            <p
              class="mt-8 max-w-prose border-l-2 border-foreground pl-5 text-xl leading-relaxed text-muted-foreground"
            >
              {t.lead}
            </p>
            <div class="mt-8"><span class={PRIMARY}>{t.secondary}</span></div>
          </div>
          <div class="mx-auto max-w-6xl px-5 py-12">
            <PrinciplesPanel
              tag="h3"
              title={t.principlesTitle}
              lead={t.principlesLead}
              items={t.principles}
            />
          </div>
          <div class="mx-auto max-w-6xl px-5 py-12">
            <h3 class={H}>{t.stepsTitle}</h3>
            <div class="mt-8"><LevelLadder levels={t.levels} /></div>
          </div>
          <div class="mx-auto max-w-6xl px-5 pb-16 pt-12">
            <CtaBand tag="h3" eyebrow={t.ctaEyebrow} title={t.ctaTitle} body={t.ctaBody}>
              <span slot="actions" class={`${BUTTON} bg-highlight-foreground text-highlight`}
                >{t.primary}</span
              >
            </CtaBand>
          </div>
        </div>
      </section>

      <section aria-labelledby="look-bold" class="space-y-3">
        <h2 id="look-bold" class="text-xl font-semibold">Bold</h2>
        <p class="text-muted-foreground">Bricolage Grotesque ({LOOKS.bold.summary}).</p>
        <pre
          class="overflow-x-auto rounded-md bg-muted px-3 py-2 font-mono text-xs"><code>node scripts/init.mjs --name my-app --out ../my-app --look bold</code></pre>
        <div
          data-look="bold"
          class:list={[FRAME, 'look-bold']}
          role="region"
          aria-label="Bold look preview"
          tabindex="0"
        >
          <HeroGraphic
            tag="h3"
            eyebrow={t.eyebrow}
            title={name}
            highlight={t.highlight}
            lead={t.lead}
          >
            <Fragment slot="actions">
              <span class={PRIMARY}>{t.primary}</span>
              <span class={SECONDARY}>{t.secondary}</span>
            </Fragment>
          </HeroGraphic>
          <div class="mx-auto max-w-6xl px-5 py-12">
            <PairedCards tag="h3" cards={cards} />
          </div>
          <div class="mx-auto max-w-6xl px-5 py-12">
            <h3 class={H}>{t.stepsTitle}</h3>
            <div class="mt-8"><LevelLadder levels={t.levels} /></div>
          </div>
          <div class="mx-auto max-w-6xl px-5 py-12">
            <PrinciplesPanel
              tag="h3"
              title={t.principlesTitle}
              lead={t.principlesLead}
              items={t.principles}
            />
          </div>
          <div class="mx-auto max-w-6xl px-5 pb-16 pt-12">
            <CtaBand tag="h3" eyebrow={t.ctaEyebrow} title={t.ctaTitle} body={t.ctaBody}>
              <span slot="actions" class={`${BUTTON} bg-highlight-foreground text-highlight`}
                >{t.primary}</span
              >
            </CtaBand>
          </div>
        </div>
      </section>

      <section aria-labelledby="look-product" class="space-y-3">
        <h2 id="look-product" class="text-xl font-semibold">Product</h2>
        <p class="text-muted-foreground">Hanken Grotesk throughout ({LOOKS.product.summary}).</p>
        <pre
          class="overflow-x-auto rounded-md bg-muted px-3 py-2 font-mono text-xs"><code>node scripts/init.mjs --name my-app --out ../my-app --look product</code></pre>
        <div
          data-look="product"
          class:list={[FRAME, 'look-product']}
          role="region"
          aria-label="Product look preview"
          tabindex="0"
        >
          <div class="mx-auto max-w-3xl px-5 pb-10 pt-16 text-center">
            <p class="font-mono text-sm uppercase tracking-widest text-primary">{t.eyebrow}</p>
            <HighlightHeadline
              tag="h3"
              size="hero"
              text={name}
              highlight={t.highlight}
              class="mt-4"
            />
            <p class="mx-auto mt-6 max-w-prose text-lg leading-relaxed text-muted-foreground">
              {t.lead}
            </p>
            <div class="mt-8 flex justify-center"><span class={PRIMARY}>{t.primary}</span></div>
          </div>
          <div class="mx-auto max-w-6xl px-5 py-12">
            <h3 class={H}>{t.stepsTitle}</h3>
            <div class="mt-8"><LevelLadder levels={t.levels} /></div>
          </div>
          <div class="mx-auto max-w-6xl px-5 py-12">
            <PairedCards tag="h3" cards={cards} />
          </div>
          <div class="mx-auto max-w-6xl px-5 pb-16 pt-12">
            <CtaBand tag="h3" eyebrow={t.ctaEyebrow} title={t.ctaTitle} body={t.ctaBody}>
              <span slot="actions" class={`${BUTTON} bg-highlight-foreground text-highlight`}
                >{t.primary}</span
              >
            </CtaBand>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style is:global>
  /* Each preview sets the look's display face on its own subtree; the blocks
     read it through the `font-display` utility. */
  .look-bold {
    --font-display: 'Bricolage Grotesque Variable', ui-sans-serif, system-ui, sans-serif;
  }
  .look-product {
    --font-display: var(--font-sans);
  }
</style>
