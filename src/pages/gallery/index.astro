---
import { withBase } from '@/lib/href';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  galleryManifest,
  categoryLabels,
  categoryOrder,
  getByCategory,
} from '../../content/gallery';
---

<BaseLayout title="Component gallery" description="Every component in this scaffold, one click away.">
  <main class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-foreground" style="view-transition-name: page-title">
        Component gallery
      </h1>
      <p class="mt-2 text-muted-foreground">
        {galleryManifest.length} components, every variant on screen, every primitive
        documented. Each page shows the rendered example in light + dark and links
        to its source file.
      </p>
    </header>

    {
      categoryOrder.map((cat) => {
        const entries = getByCategory(cat);
        if (entries.length === 0) return null;
        return (
          <section class="mb-10">
            <h2 class="mb-4 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              {categoryLabels[cat]}
            </h2>
            <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {entries.map((entry) => (
                <li>
                  <a
                    href={withBase(`/gallery/${entry.slug}/`)}
                    class="group block rounded-lg border border-border bg-card p-4 transition-colors hover:bg-accent/40"
                  >
                    <div class="flex items-start justify-between gap-2">
                      <h3 class="text-sm font-semibold text-foreground group-hover:underline">
                        {entry.name}
                      </h3>
                      <span
                        class:list={[
                          'rounded-full px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide',
                          entry.status === 'stable' &&
                            'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30',
                          entry.status === 'beta' &&
                            'bg-yellow-500/15 text-yellow-300 border border-yellow-500/30',
                          entry.status === 'experimental' &&
                            'bg-orange-500/15 text-orange-300 border border-orange-500/30',
                        ]}
                      >
                        {entry.status}
                      </span>
                    </div>
                    <p class="mt-1.5 text-xs text-muted-foreground">{entry.summary}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }

    <footer class="mt-12 border-t border-border pt-6 text-sm text-muted-foreground">
      <p>
        Looking for composed demos? Visit
        <a href={withBase('/demos/')} class="text-primary hover:underline">/demos</a>
        for full dashboard / data / PWA pages.
      </p>
      <p class="mt-1">
        Building something new? See the
        <a href={withBase('/docs/building/adding-a-component/')} class="text-primary hover:underline">
          contribution guide
        </a>.
      </p>
    </footer>
  </main>
</BaseLayout>
