---
import { withBase } from '@/lib/href';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppLayoutIsland from '@/components/islands/AppLayoutIsland';
---

<BaseLayout
  title="App Layout — Service Shell"
  description="Reusable service shell pattern: left nav, top bar, main content, optional split panel."
>
  <main class="mx-auto max-w-7xl px-4 py-12 space-y-8">
    <header>
      <h1 class="text-3xl font-bold tracking-tight" style="view-transition-name: page-title">
        App Layout — Service Shell
      </h1>
      <p class="mt-2 text-muted-foreground max-w-2xl">
        A reusable shell component with a left navigation area, top utilities bar, main content
        region, and an optional split panel for contextual details. Fully keyboard-navigable and
        responsive down to mobile.
      </p>
    </header>

    <!-- Demo 1: Default layout state -->
    <section aria-labelledby="demo-default-heading">
      <h2 id="demo-default-heading" class="text-xl font-semibold mb-3">
        Default layout state
      </h2>
      <p class="text-sm text-muted-foreground mb-4">
        Left nav + top bar + main content. No split panel. Resize below 768 px to see the mobile
        hamburger menu.
      </p>

      <div class="rounded-xl border border-border overflow-hidden" style="height: 420px">
        <AppLayoutIsland
          client:load
          navItems={[
            { id: 'dashboard', label: 'Dashboard', active: true },
            { id: 'projects', label: 'Projects' },
            { id: 'team', label: 'Team' },
            { id: 'settings', label: 'Settings' },
          ]}
          topActions={null}
        >
          <div class="space-y-4">
            <h3 class="text-lg font-semibold">Dashboard</h3>
            <p class="text-sm text-muted-foreground">
              This is the main content region. It scrolls independently. The left nav and top bar
              stay fixed.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              {['Revenue', 'Users', 'Requests'].map((kpi) => (
                <div
                  key={kpi}
                  class="rounded-lg border border-border bg-card p-4"
                >
                  <p class="text-xs text-muted-foreground">{kpi}</p>
                  <p class="mt-1 text-2xl font-bold">—</p>
                </div>
              ))}
            </div>
          </div>
        </AppLayoutIsland>
      </div>
    </section>

    <!-- Demo 2: Split panel enabled -->
    <section aria-labelledby="demo-split-heading">
      <h2 id="demo-split-heading" class="text-xl font-semibold mb-3">
        Split panel enabled state
      </h2>
      <p class="text-sm text-muted-foreground mb-4">
        Click the panel-toggle button in the top-right to open/close the details panel. On
        screens ≥ 1024 px the panel appears as a side-by-side column; on smaller screens it
        stacks below the main content.
      </p>

      <div class="rounded-xl border border-border overflow-hidden" style="height: 420px">
        <AppLayoutIsland
          client:load
          defaultSplitOpen={true}
          navItems={[
            { id: 'resources', label: 'Resources', active: true },
            { id: 'logs', label: 'Logs' },
            { id: 'alerts', label: 'Alerts' },
          ]}
          splitPanelContent={
            <div class="p-4 space-y-3">
              <h3 class="text-sm font-semibold">Resource details</h3>
              <dl class="space-y-2 text-xs">
                <div class="flex justify-between">
                  <dt class="text-muted-foreground">Name</dt>
                  <dd class="font-medium">api-service-prod</dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-muted-foreground">Region</dt>
                  <dd class="font-medium">us-east-1</dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-muted-foreground">Status</dt>
                  <dd class="font-medium text-green-600 dark:text-green-400">Running</dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-muted-foreground">Uptime</dt>
                  <dd class="font-medium">14d 6h</dd>
                </div>
              </dl>
            </div>
          }
        >
          <div class="space-y-4">
            <h3 class="text-lg font-semibold">Resources</h3>
            <p class="text-sm text-muted-foreground">
              Select a resource to populate the details panel on the right. Toggle the panel
              with the button in the top bar.
            </p>
            <ul class="space-y-2">
              {['api-service-prod', 'web-frontend-prod', 'db-primary'].map((name) => (
                <li
                  key={name}
                  class="flex items-center justify-between rounded-lg border border-border bg-card px-4 py-2 text-sm"
                >
                  <span class="font-medium">{name}</span>
                  <span class="text-xs text-green-600 dark:text-green-400">Running</span>
                </li>
              ))}
            </ul>
          </div>
        </AppLayoutIsland>
      </div>
    </section>

    <!-- Keyboard navigation docs -->
    <section aria-labelledby="keyboard-heading">
      <h2 id="keyboard-heading" class="text-xl font-semibold mb-3">Keyboard navigation</h2>
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-border">
            <th class="py-2 pr-8 text-left font-medium">Key</th>
            <th class="py-2 text-left font-medium">Behaviour</th>
          </tr>
        </thead>
        <tbody>
          {[
            ['Tab / Shift+Tab', 'Move focus between nav items, top-bar buttons, and main content'],
            ['Enter / Space', 'Activate the focused nav item or button'],
            ['Escape', 'Close the mobile nav drawer when open'],
          ].map(([key, desc]) => (
            <tr key={key} class="border-b border-border last:border-0">
              <td class="py-2 pr-8">
                <kbd class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">{key}</kbd>
              </td>
              <td class="py-2 text-muted-foreground">{desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <!-- Mobile behaviour -->
    <section aria-labelledby="mobile-heading">
      <h2 id="mobile-heading" class="text-xl font-semibold mb-3">Mobile behaviour</h2>
      <ul class="space-y-2 text-sm text-muted-foreground list-disc list-inside">
        <li>The left sidebar is hidden below the <code>md</code> (768 px) breakpoint.</li>
        <li>A hamburger button in the top bar opens a drawer overlay with the nav items.</li>
        <li>The drawer closes on Escape, backdrop click, or nav-item selection.</li>
        <li>On resize back to desktop width, the mobile nav auto-closes.</li>
        <li>The split panel stacks below main content on screens narrower than <code>lg</code> (1024 px).</li>
      </ul>
    </section>

    <footer class="border-t border-border pt-6 text-sm text-muted-foreground flex flex-wrap gap-x-6 gap-y-2">
      <a href={withBase('/gallery/')} class="underline underline-offset-4 hover:text-foreground">
        ← Gallery
      </a>
      <a
        href="https://github.com/ArtemioPadilla/inceptor/blob/main/src/components/islands/AppLayoutIsland.tsx"
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-4 hover:text-foreground"
      >
        View source on GitHub ↗
      </a>
      <a href={withBase('/docs/foundation/layout')} class="underline underline-offset-4 hover:text-foreground">
        Layout docs ↗
      </a>
    </footer>
  </main>
</BaseLayout>
