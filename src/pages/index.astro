---
import BaseLayout from '../layouts/BaseLayout.astro';
import { galleryManifest, categoryOrder, categoryLabels, getByCategory } from '../content/gallery';
---

<BaseLayout title="issue-driven-web-template" lang="en">
  <main class="mx-auto max-w-6xl px-4 py-12">

    <section class="mb-16 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5 text-sm font-medium text-emerald-400">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Issue-Driven Development
      </div>

      <h1
        class="mt-6 text-4xl font-bold tracking-tight text-foreground sm:text-5xl"
        style="view-transition-name: page-title"
      >
        A scaffold that ships everything you need.
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-base text-muted-foreground sm:text-lg">
        Astro 5 · React 19 · Tailwind v4 · shadcn/Base UI · TanStack · Tremor Raw · Motion · PWA.
        Plus Shape Up cadence, TDD with commit trailers, Zod-driven Spec-DD, and an 8-item
        ethics checklist baked into the workflow.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/docs/start-here/quick-start/"
          class="inline-flex items-center gap-2 rounded-lg border border-emerald-500 bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-emerald-950 transition-colors hover:bg-emerald-400"
        >
          Quick start →
        </a>
        <a
          href="/gallery/"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-accent/40"
        >
          Component gallery
        </a>
        <a
          href="/demos/"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-accent/40"
        >
          Demos
        </a>
        <a
          href="/docs/"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-accent/40"
        >
          Docs
        </a>
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-accent/40"
        >
          Blog
        </a>
        <a
          href="https://github.com/ArtemioPadilla/issue-driven-web-template"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-accent/40"
        >
          GitHub ↗
        </a>
      </div>
    </section>

    <!-- What's inside grid -->
    <section class="mb-16">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-2xl font-bold text-foreground">What's inside</h2>
        <a href="/gallery/" class="text-sm text-primary hover:underline">Browse all {galleryManifest.length} →</a>
      </div>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          categoryOrder.slice(0, 6).map((cat) => {
            const entries = getByCategory(cat);
            if (entries.length === 0) return null;
            const first = entries[0];
            return (
              <li>
                <a
                  href={`/gallery/${first.slug}/`}
                  class="group block h-full rounded-lg border border-border bg-card p-5 transition-colors hover:bg-accent/40"
                >
                  <p class="text-xs uppercase tracking-wider text-muted-foreground">
                    {categoryLabels[cat]}
                  </p>
                  <h3 class="mt-1 text-base font-semibold text-foreground group-hover:underline">
                    {first.name}
                  </h3>
                  <p class="mt-2 text-sm text-muted-foreground">{first.summary}</p>
                  {entries.length > 1 && (
                    <p class="mt-3 text-xs text-muted-foreground">
                      + {entries.length - 1} more in {categoryLabels[cat].toLowerCase()}
                    </p>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <!-- IDD pitch -->
    <section class="mb-16 rounded-xl border border-border bg-card p-8 text-card-foreground">
      <h2 class="text-2xl font-bold">How development happens here</h2>
      <ol class="mt-4 space-y-3 text-sm text-muted-foreground">
        <li class="flex gap-3">
          <span class="font-mono text-primary">1.</span>
          <span><strong class="text-foreground">File the issue</strong> — use a template or run <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">npm run new-issue</code>.</span>
        </li>
        <li class="flex gap-3">
          <span class="font-mono text-primary">2.</span>
          <span><strong class="text-foreground">Invoke <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">/goal</code></strong> — prometeo plans, forja implements with a red→green test first, centinela validates.</span>
        </li>
        <li class="flex gap-3">
          <span class="font-mono text-primary">3.</span>
          <span><strong class="text-foreground">PR opens</strong> with the issue reference, sub-agent reports, ethics checklist. CI re-validates.</span>
        </li>
        <li class="flex gap-3">
          <span class="font-mono text-primary">4.</span>
          <span><strong class="text-foreground">Merge.</strong> Issue closes automatically. Visual regression snapshots both `/gallery` and `/demos`.</span>
        </li>
      </ol>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/docs/start-here/idd-tour/" class="text-sm font-semibold text-primary hover:underline">
          Read the 60-second tour →
        </a>
        <a href="/docs/how-we-work/idd/" class="text-sm text-muted-foreground hover:text-foreground">
          Full workflow doc
        </a>
      </div>
    </section>

    <!-- FAB hint -->
    <p class="text-center text-xs text-muted-foreground">
      Click the <span class="text-emerald-400">chat bubble</span> in the bottom-right to file a bug with full diagnostics pre-filled.
    </p>

  </main>
</BaseLayout>
