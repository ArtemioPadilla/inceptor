---
import { withBase } from '@/lib/href';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlockPreviewToggle from '../../components/gallery/BlockPreviewToggle.astro';
import LoginForm from '../../components/islands/LoginForm';
import loginFormSource from '../../components/islands/LoginForm.tsx?raw';
---

<BaseLayout
  title="Login block — inceptor"
  description="An installable login/auth page block: Form + react-hook-form + zod, PasswordInput, forgot-password and sign-up links."
>
  <main class="mx-auto max-w-3xl px-4 py-12 space-y-6">
    <header>
      <h1 class="text-3xl font-bold tracking-tight" style="view-transition-name: page-title">
        Login block
      </h1>
      <p class="mt-2 text-muted-foreground">
        A branded, centered login form — email/password (with the Epic 21
        <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">PasswordInput</code>),
        a submit button, a "Forgot password?" link, and an optional "Sign up" link. No
        auth backend wired: submission is a demo stub, same shape as
        <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">ContactForm</code>/<code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">NewsletterForm</code>.
        See the full page composition at <a href={withBase('/login/')} class="text-primary underline underline-offset-2 hover:text-primary/80">/login</a>.
      </p>
    </header>

    <BlockPreviewToggle id="login" code={loginFormSource} lang="tsx">
      <div class="rounded-xl border border-border bg-card p-6">
        <LoginForm signUpHref="#" client:visible />
      </div>
    </BlockPreviewToggle>

    <footer class="border-t border-border pt-6 text-sm text-muted-foreground flex flex-wrap gap-x-6 gap-y-2">
      <a href={withBase('/blocks/')} class="underline underline-offset-4 hover:text-foreground">
        ← Back to blocks
      </a>
      <a
        href="https://github.com/ArtemioPadilla/inceptor/blob/main/src/components/islands/LoginForm.tsx"
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-4 hover:text-foreground"
      >
        View source on GitHub ↗
      </a>
    </footer>
  </main>
</BaseLayout>
