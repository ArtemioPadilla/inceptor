---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShowcaseDialog from '../components/islands/ShowcaseDialog';
import ShowcaseDropdown from '../components/islands/ShowcaseDropdown';
import ShowcaseForm from '../components/islands/ShowcaseForm';
import ShowcaseKpis from '../components/islands/ShowcaseKpis';
import ShowcaseSimples from '../components/islands/ShowcaseSimples';
import ShowcaseTabs from '../components/islands/ShowcaseTabs';
import ShowcaseToast from '../components/islands/ShowcaseToast';
import ThemeIndicator from '../components/islands/ThemeIndicator';
import QueryDemo from '../components/islands/QueryDemo';
import ShowcaseDataTable from '../components/islands/ShowcaseDataTable';
import ShowcaseCharts from '../components/islands/ShowcaseCharts';

// /showcase — living documentation for every installed shadcn/ui component.
// Each section renders the component in both light and dark side-by-side.
//
// Compound components (Dialog, DropdownMenu, Tabs, Toast, Form) are wrapped in
// their own island files under src/components/islands/ per the compound-component
// gotcha documented in CLAUDE.md. All islands use client:visible — these are
// below-the-fold demos that don't need eager hydration.
//
// The dark column applies the `.dark` class directly on a wrapper div so the
// dark tokens kick in independently of the page-level theme. This lets visitors
// preview both themes regardless of their current OS/toggle preference.
---

<BaseLayout title="Component showcase" description="Visual showcase of all installed shadcn/ui components in light and dark mode">
  <main class="mx-auto max-w-7xl px-4 py-12 space-y-12">
    <header class="space-y-4">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <h1 class="text-3xl font-bold tracking-tight">Component showcase</h1>
        <!--
          ThemeIndicator: live-reflects the $theme Nano Store. Proves that a
          separate island (ThemeToggle) and this island share state without
          React Context. Toggle the theme button in the top-right corner and
          watch this badge update immediately.
        -->
        <ThemeIndicator client:visible />
      </div>
      <p class="mt-2 text-muted-foreground">
        Each component rendered in both light and dark. Compound components are
        hydrated as single React islands per
        <a
          href="https://github.com/ArtemioPadilla/issue-driven-web-template/blob/main/CLAUDE.md"
          class="underline underline-offset-4 hover:text-foreground"
          target="_blank"
          rel="noopener noreferrer"
        >
          CLAUDE.md's compound-component gotcha
        </a>.
      </p>
    </header>

    <!-- Primitives: Button, Input, Label, Card, Table, Badge -->
    <section aria-labelledby="section-primitives">
      <h2 id="section-primitives" class="text-xl font-semibold mb-4">Primitives</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Light</p>
          <ShowcaseSimples client:visible />
        </div>
        <div class="dark rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Dark</p>
          <ShowcaseSimples client:visible />
        </div>
      </div>
    </section>

    <!-- Dialog -->
    <section aria-labelledby="section-dialog">
      <h2 id="section-dialog" class="text-xl font-semibold mb-4">Dialog</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Light</p>
          <ShowcaseDialog client:visible />
        </div>
        <div class="dark rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Dark</p>
          <ShowcaseDialog client:visible />
        </div>
      </div>
    </section>

    <!-- DropdownMenu -->
    <section aria-labelledby="section-dropdown">
      <h2 id="section-dropdown" class="text-xl font-semibold mb-4">Dropdown menu</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Light</p>
          <ShowcaseDropdown client:visible />
        </div>
        <div class="dark rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Dark</p>
          <ShowcaseDropdown client:visible />
        </div>
      </div>
    </section>

    <!-- Tabs -->
    <section aria-labelledby="section-tabs">
      <h2 id="section-tabs" class="text-xl font-semibold mb-4">Tabs</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Light</p>
          <ShowcaseTabs client:visible />
        </div>
        <div class="dark rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Dark</p>
          <ShowcaseTabs client:visible />
        </div>
      </div>
    </section>

    <!-- Toast -->
    <section aria-labelledby="section-toast">
      <h2 id="section-toast" class="text-xl font-semibold mb-4">Toast</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Light</p>
          <ShowcaseToast client:visible />
        </div>
        <div class="dark rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Dark</p>
          <ShowcaseToast client:visible />
        </div>
      </div>
    </section>

    <!-- Form -->
    <section aria-labelledby="section-form">
      <h2 id="section-form" class="text-xl font-semibold mb-4">Form</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Light</p>
          <ShowcaseForm client:visible />
        </div>
        <div class="dark rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Dark</p>
          <ShowcaseForm client:visible />
        </div>
      </div>
    </section>
    <!-- DataTable (TanStack Table + Virtual) -->
    <section aria-labelledby="section-datatable">
      <h2 id="section-datatable" class="text-xl font-semibold mb-4">Data table</h2>
      <p class="text-sm text-muted-foreground mb-4">
        Generic <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">&lt;DataTable&gt;</code>
        powered by TanStack Table v8 + TanStack Virtual. Supports sort, global filter,
        column visibility toggle, column resizing, and row virtualization.
        Consume it inside a single React island file (compound-component rule applies).
      </p>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Light</p>
          <ShowcaseDataTable client:visible />
        </div>
        <div class="dark rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Dark</p>
          <ShowcaseDataTable client:visible />
        </div>
      </div>
    </section>

    <!-- TanStack Query (persisted) -->
    <section aria-labelledby="section-query">
      <h2 id="section-query" class="text-xl font-semibold mb-4">TanStack Query (persisted)</h2>
      <p class="text-sm text-muted-foreground mb-4">
        Repo stats fetched via TanStack Query and persisted to IndexedDB. Reload to
        see cached data render before the network round-trip completes.
      </p>
      <QueryDemo client:visible />
    </section>

    <!-- KPI cards & trackers (Tremor Raw) -->
    <section aria-labelledby="section-kpi">
      <h2 id="section-kpi" class="text-xl font-semibold mb-4">KPI cards &amp; trackers</h2>
      <p class="text-sm text-muted-foreground mb-4">
        Copy-paste Tremor Raw primitives:
        <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">KpiCard</code>,
        <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">Metric</code>,
        <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">ProgressBar</code>,
        <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">Tracker</code>,
        <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">Callout</code>,
        <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">Divider</code>.
        All themed via shadcn CSS vars — no <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">@tremor/react</code> dependency.
      </p>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Light</p>
          <ShowcaseKpis client:visible />
        </div>
        <div class="dark rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Dark</p>
          <ShowcaseKpis client:visible />
        </div>
      </div>
    </section>
    <!-- Charts (Recharts wrappers themed to shadcn CSS vars) -->
    <section aria-labelledby="section-charts">
      <h2 id="section-charts" class="text-xl font-semibold mb-4">Charts</h2>
      <p class="text-sm text-muted-foreground mb-4">
        Recharts wrappers that read colors from
        <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">--chart-1</code>
        …
        <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">--chart-5</code>
        CSS vars — dark mode flips automatically. Components:
        <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">LineChart</code>,
        <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">BarChart</code>,
        <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">AreaChart</code>,
        <code class="font-mono text-xs bg-muted px-1 py-0.5 rounded">DonutChart</code>.
      </p>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Light</p>
          <ShowcaseCharts client:visible />
        </div>
        <div class="dark rounded-lg border border-border bg-background p-6">
          <p class="text-xs uppercase tracking-wide text-muted-foreground mb-4">Dark</p>
          <ShowcaseCharts client:visible />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
